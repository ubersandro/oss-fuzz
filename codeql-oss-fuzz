#!/bin/bash -eu
# codeql-oss-fuzz: build the OSS-Fuzz project in $SRC under the CodeQL tracer.
#
#   codeql-oss-fuzz [DB_DIR]                  database only (default: $OUT/codeql-db)
#   codeql-oss-fuzz DB_DIR QUERY|PACK ...     also run the queries, SARIF in DB_DIR.sarif
#
# The build runs OSS-Fuzz's own `compile` (i.e. $SRC/build.sh) with a plain
# clang and no sanitizer: CodeQL looks at the source, and sanitizer flags it
# does not know (e.g. FSan's) only add extractor noise. Set CODEQL_KEEP_ENV=1
# to keep the image's CC/CXX/CFLAGS/SANITIZER instead.

DB=${1:-$OUT/codeql-db}
shift || true

# CODEQL_KEEP_ENV=${CODEQL_KEEP_ENV:-0}
# if [ "${CODEQL_KEEP_ENV}" != 1 ]; then
#   export CC=${CODEQL_CC:-/usr/local/bin/clang}
#   export CXX=${CODEQL_CXX:-/usr/local/bin/clang++}
#   export CFLAGS="-O1 -fno-omit-frame-pointer -gline-tables-only"
#   export CXXFLAGS="$CFLAGS ${CXXFLAGS_EXTRA:-}"
#   export LDFLAGS=""
#   export SANITIZER=none
#   unset SANITIZER_FLAGS  # `compile` only derives it from $SANITIZER when unset
#   export FUZZING_ENGINE=libfuzzer
# fi
# Normally passed by infra/helper.py from project.yaml.
export FUZZING_LANGUAGE=${FUZZING_LANGUAGE:-c++}
# A ccache hit compiles nothing, so the tracer would see nothing.
export CCACHE_DISABLE=1
export SANITIZER=none


if [ $# -gt 0 ]; then
  codeql database analyze "$DB" --threads=0 \
    --format=sarif-latest --output="$DB.sarif" "$@"
else
  codeql database create "$DB" --overwrite --language=c-cpp \
    --source-root="$SRC" --working-dir="$PWD" --command=/src/build.sh --threads=0 --ram="${CODEQL_RAM:-8192}"
fi