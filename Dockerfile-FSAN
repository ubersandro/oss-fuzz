FROM gcr.io/oss-fuzz-base/base-builder
# PROBLEM: unpinned base version, minor

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y openssh-client nano vim gdb cmake ninja-build tmux lldb htop && apt-get clean && rm -rf /var/lib/apt/lists/*

# copy & build LLVM
RUN mkdir $SRC/fsan
WORKDIR $SRC/fsan
COPY llvm-project $SRC/fsan/llvm-project
ENV LLVM="$SRC/fsan/llvm-project/"
WORKDIR $LLVM
RUN rm -rf build build-runtimes || true
RUN mkdir build build-runtimes  || true
# RUN git checkout 78919a58dbdfb4286f353a1ddc1251c055eb7062 
# TODO: fix to latest commit
RUN git log | head -1 > /src/FSAN.version

ENV CFLAGS=""
ENV CXXFLAGS=""
ENV CXXFLAGS_EXTRA=""
ENV CC=""
ENV CXX=""
ENV LDFLAGS=""

WORKDIR $LLVM/build
# Always enable assertions to check everything is good
# RUN cmake -DLLVM_ENABLE_PROJECTS="clang;lld" -DLLVM_ENABLE_RUNTIMES="compiler-rt" -DCMAKE_BUILD_TYPE=Release -GNinja -DLLVM_PARALLEL_LINK_JOBS=6  -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON -DCLANG_ENABLE_STATIC_ANALYZER=OFF -DCLANG_ENABLE_ARCMT=OFF ../llvm -DLLVM_FORCE_ENABLE_STATS=ON
RUN cmake -DLLVM_ENABLE_PROJECTS="clang;lld" -DLLVM_ENABLE_RUNTIMES="compiler-rt" -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_ASSERTIONS=On -GNinja -DLLVM_PARALLEL_LINK_JOBS=1 -DCLANG_ENABLE_STATIC_ANALYZER=OFF -DCLANG_ENABLE_ARCMT=OFF -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DLLVM_ENABLE_LLD=ON ../llvm/ -DLLVM_FORCE_ENABLE_STATS=ON
RUN ninja -j120 # limit

WORKDIR $LLVM/build-runtimes
RUN cmake -DLLVM_ENABLE_ASSERTIONS=On -GNinja -DLLVM_PARALLEL_LINK_JOBS=1 -DLLVM_TARGETS_TO_BUILD="x86-64"  -DCMAKE_C_COMPILER=/src/fsan/llvm-project/build/bin/clang -DCMAKE_CXX_COMPILER=/src/fsan/llvm-project/build/bin/clang++ -DCMAKE_EXPORT_COMPILE_COMMANDS=ON  -DLLVM_ENABLE_RUNTIMES="libcxx;libcxxabi;libunwind" -DCMAKE_BUILD_TYPE=Release  -DLIBCXXABI_USE_LLVM_UNWINDER=ON  -DRUNTIMES_CMAKE_C_COMPILER=/src/fsan/llvm-project/build/bin/clang -DRUNTIMES_CMAKE_CXX_COMPILER=/src/fsan/llvm-project/build/bin/clang++  -DLLVM_USE_LINKER=/src/fsan/llvm-project/build/bin/ld.lld -DClang_DIR=/src/fsan/llvm-project/build/lib/cmake/clang -DLLVM_DIR=/src/fsan/llvm-project/build/lib/cmake/llvm -DCMAKE_CXX_FLAGS="-mllvm -rewrite-ptr-subs=1"  -DCMAKE_C_FLAGS="-mllvm -rewrite-ptr-subs=1" ../runtimes
RUN ninja -j120

# SET ENV FOR FUZZING
ENV LLVM_BUILD="$LLVM/build"
ENV LLVM_BIN="$LLVM_BUILD/bin"
ENV LLVM_LIB="$LLVM_BUILD/lib/x86_64-unknown-linux-gnu"
ENV LLVM_AS="$LLVM_BIN/llvm-as"
ENV LLVM_AR="$LLVM_BIN/llvm-ar"
ENV LLVM_RANLIB="$LLVM_BIN/llvm-ranlib"

# AFL - clone pinned version
ENV AFL="$SRC/aflplusplus"
RUN rm -rf $AFL || true
RUN git clone https://github.com/ubersandro/AFLplusplus.git $AFL
WORKDIR $AFL

# APPLY PATCH FOR FSAN LTO
RUN sed -i 's/\- \-flto=full/\- \-flto\=full \-\-ld-path=\/src\/fsan\/llvm\-project\/build\/bin\/ld.lld/g' $AFL/GNUmakefile.llvm

RUN sed -i 's/\- \-flto=thin/\- \-flto\=thin \-\-ld-path=\/src\/fsan\/llvm\-project\/build\/bin\/ld.lld/g' $AFL/GNUmakefile.llvm

RUN sed -i 's/\- \-flto/\- \-flto \-\-ld-path=\/src\/fsan\/llvm\-project\/build\/bin\/ld.lld/g' $AFL/GNUmakefile.llvm

# NOTE: this is going to build AFL with regular LLVM (minus some changes we can't tweak in the current implementation of FSan because we touch the anlyses in LLVM. Performance toll should be limited though.)
RUN LLVM_CONFIG=$LLVM_BIN/llvm-config make -j12 CC=$LLVM_BIN/clang CXX=$LLVM_BIN/clang++ LDFLAGS="--ld-path=/src/fsan/llvm-project/build/bin/ld.lld" AR=$LLVM_BIN/llvm-ar AS=$LLVM_BIN/llvm-as RANLIB=$LLVM_BIN/llvm-ranlib

ENV CC="$AFL/afl-clang-fast"
ENV CXX="$AFL/afl-clang-fast++"

# COMPILER FLAGS
ENV COMMON_COMP_FLAGS="-O2 -gline-tables-only -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION -pthread -fno-common -fno-data-sections -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer -L/src/fsan/llvm-project/build/lib/ -fno-discard-value-names"
# NOTE: fno-discard-value-names is fundamental for the pass to remove SROA-related FPs and similar.

# NOTE: fsan-heap controls the behavior of the front-end
ENV FSAN_CONFIG_COMPILE_FLAGS="-fsanitize=hwaddress,fsan,fsan-heap  -mllvm -disable-loop-idiom-all -mllvm -vectorize-slp=0 -mllvm -vectorize-loops=0 -mllvm -verify-machineinstrs -mllvm -instcombine-fsan=1 -mllvm -instcombine-disable-load-store-alloca=1 -mllvm -hwasan-instrument-byval=0 -mllvm -fsan-blocklist-tag-filepath=/src/fsan.blocklist -mllvm -fsan-disable-gvn=0 -mllvm -fsan-disable-earlycse=0 -mllvm -fsan-disable-indvarsimplify=1 -mllvm -fsan-disable-aggressive-instcombine=0 -mllvm -rewrite-ptr-subs=1"

ENV CXXFLAGS="$COMMON_COMP_FLAGS -stdlib=libc++ -nostdinc++ -isystem /src/fsan/llvm-project/build/include/c++/v1 $FSAN_CONFIG_COMPILE_FLAGS"
ENV CFLAGS="$COMMON_COMP_FLAGS $FSAN_CONFIG_COMPILE_FLAGS"

# LINKER FLAGS
ENV LD="$LLVM/build/bin/ld.lld"
ENV LDFLAGS="-fsanitize=hwaddress --ld-path=/src/fsan/llvm-project/build/bin/ld.lld -L/src/fsan/llvm-project/build/lib -stdlib=libc++ --unwindlib=libunwind --rtlib=compiler-rt -Wl,-rpath=/src/fsan/llvm-project/build/lib"

ENV CXXFLAGS_EXTRA=""
ENV CCACHE_DISABLE=1
RUN rm -rf `which ccache` || true

ENV HWASAN_SYMBOLIZER_PATH="/usr/local/bin/llvm-symbolizer"
ENV ASAN_SYMBOLIZER_PATH="/usr/local/bin/llvm-symbolizer"
ENV HWASAN_OPTIONS="verbosity=0:symbolize=0:halt_on_error=1:abort_on_error=1:detect_leaks=0"


RUN touch /src/fsan.blocklist

RUN cp $AFL/utils/aflpp_driver/libAFLDriver.a /usr/lib/libFuzzingEngine.a

# copy relevant scripts to 
# start fuzzing getting corpora from upstream oss-fuzz when available. When not available, repurpose local ones.
COPY oss-fuzz/start-campaign.sh $SRC/fuzz.sh
RUN chmod +x $SRC/fuzz.sh

COPY oss-fuzz/quick-check.sh $SRC/quick-check.sh
RUN chmod +x $SRC/quick-check.sh
# TODO: restart-campaign.sh script

# schedule fuzzers in tmux session
COPY oss-fuzz/schedule-fuzzer.sh $SRC/schedule-fuzzer.sh
RUN chmod +x $SRC/schedule-fuzzer.sh

# collect fuzzer results
COPY oss-fuzz/results.sh $SRC/results.sh
RUN chmod +x $SRC/results.sh

# check the results to identify tag violations and eventual spurious/other crashes
COPY oss-fuzz/collect-fuzzer-output.sh $SRC/collect-fuzzer-output.sh
RUN chmod +x $SRC/collect-fuzzer-output.sh

COPY oss-fuzz/post-processing.sh $SRC/post-processing.sh
RUN chmod +x $SRC/post-processing.sh

COPY oss-fuzz/gather-other.sh $SRC/gather-other.sh
RUN chmod +x $SRC/gather-other.sh # script to find other crashes

WORKDIR $SRC

RUN echo "alias rebuildllvm='cd /src/fsan/llvm-project/build && ninja && cd -'" >> ~/.bashrc
RUN echo 'alias fuzzercheck="for d in \$(find /out/ -name \"*_0\"); do /src/aflplusplus/afl-whatsup \$d ; done | grep -E \"instance|Crashes\""' >> ~/.bashrc
RUN echo "alias symenable='export HWASAN_SYMBOLIZER_PATH=/src/fsan/llvm-project/build/bin/llvm-symbolizer; export HWASAN_OPTIONS=verbosity=0:symbolize=1:halt_on_error=1:abort_on_error=1:detect_leaks=0'" >> ~/.bashrc

RUN echo "alias symdisable='export HWASAN_SYMBOLIZER_PATH=/src/fsan/llvm-project/build/bin/llvm-symbolizer; export HWASAN_OPTIONS=verbosity=0:symbolize=0:halt_on_error=1:abort_on_error=1:detect_leaks=0'" >> ~/.bashrc

RUN echo "alias buildproj='pushd /src/$PROJECT && /src/build.sh 2>&1 | tee /tmp/log'" >> ~/.bashrc 

# generate output in /fuzzing-campaign/results.txt
RUN echo "alias prodresults='/src/post-processing.sh | grep FUZZER | cut -f2,6 -d\" \" > /fuzzing-campaign/results.txt'" >> ~/.bashrc

# requires file /fuzzing-campaign/results.txt to exist
RUN echo "alias genoutput='while read l; do echo "INPUT: $l"; $l 2>&1 ; done < /fuzzing-campaign/results.txt  > /fuzzing-campaign/results_output.txt'" >> ~/.bashrc